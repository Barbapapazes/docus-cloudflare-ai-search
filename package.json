{
  "name": "docus-cloudflare-ai-search",
  "version": "0.0.3",
  "description": "Replace Docus default search with Cloudflare AI Search",
  "author": "Estéban Soubiran <esteban@soubiran.dev>",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "funding": "https://github.com/sponsors/Barbapapazes",
  "homepage": "https://github.com/Barbapapazes/docus-cloudflare-ai-search#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Barbapapazes/docus-cloudflare-ai-search.git"
  },
  "bugs": {
    "url": "https://github.com/Barbapapazes/docus-cloudflare-ai-search/issues"
  },
  "keywords": [
    "cloudflare",
    "cloudflare-ai-search",
    "docus",
    "nuxt",
    "search"
  ],
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nuxt-module-build prepare && nuxt-module-build build",
    "prepack": "pnpm run build",
    "dev": "pnpm run dev:prepare && nuxt dev .playground",
    "dev:build": "nuxt build .playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare .playground",
    "release": "bumpp --sign",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit && cd .playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/kit": "^4.5.2",
    "@nuxt/ui": "^4.11.0",
    "@vueuse/core": "^14.4.0"
  },
  "peerDependencies": {
    "@nuxt/content": "^3.0.0",
    "docus": ">=5.0.0",
    "nuxt": "^4.0.0"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@types/node": "latest",
    "bumpp": "^12.2.1",
    "eslint": "^10.8.0",
    "nuxt": "^4.5.2",
    "taze": "^19.9.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.9"
  }
}
